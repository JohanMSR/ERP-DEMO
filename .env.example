# ================================================================
# ERP Referral System — Docker environment
# ================================================================
# Copy to .env and adjust for local or production:
#   cp .env.example .env
# ================================================================

# --- Local development (defaults below work out of the box) ---
# NETWORK_EXTERNAL=false
# TRAEFIK_ENABLE=false
# BACKEND_HOST_PORT=5500
# FRONTEND_HOST_PORT=5066
# FRONTEND_URL=http://localhost:5066
# REACT_APP_API_URL=http://localhost:5500/api
# CREATE_TEST_DATA=false
# FLASK_ENV=development

# --- Production (uncomment and set) ---
# NETWORK_EXTERNAL=true
# TRAEFIK_ENABLE=true
# TRAEFIK_HOST=147.93.5.220
# SERVER_IP=147.93.5.220
# FRONTEND_URL=http://147.93.5.220:5066
# REACT_APP_API_URL=http://147.93.5.220:5500/api
# CREATE_TEST_DATA=true
# FLASK_ENV=production
# SECRET_KEY=generate-with-python-secrets-token_hex-32

# Host ports (mapped to container 5000 / 3000)
BACKEND_HOST_PORT=5500
FRONTEND_HOST_PORT=5066

# URLs seen by the browser (must match host ports above)
FRONTEND_URL=http://localhost:5066
REACT_APP_API_URL=http://localhost:5500/api

# Docker network: false = compose creates it; true = run: docker network create elantar_net
NETWORK_EXTERNAL=false
NETWORK_NAME=elantar_net

# Traefik (production behind reverse proxy)
TRAEFIK_ENABLE=false
TRAEFIK_HOST=localhost

# Backend
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me-in-production
CREATE_TEST_DATA=false

# Optional containers names
# BACKEND_CONTAINER_NAME=elantar-backend
# FRONTEND_CONTAINER_NAME=elantar-frontend
