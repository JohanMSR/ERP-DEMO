# ================================================================
# Production overrides — copy to .env on the server
# ================================================================
#   cp env.production.example .env
# Also see .env.example for the full variable list.
# ================================================================

NETWORK_EXTERNAL=false
NETWORK_NAME=erp_net

# Use Dokploy Domains UI (recommended) — set TRAEFIK_ENABLE=false
TRAEFIK_ENABLE=false
TRAEFIK_HOST=scale.147.93.5.220.sslip.io

BACKEND_HOST_PORT=5500
FRONTEND_HOST_PORT=5067

FLASK_ENV=production
FLASK_APP=run.py
SECRET_KEY=your-super-secret-key-change-this-immediately

FRONTEND_URL=http://scale.147.93.5.220.sslip.io
REACT_APP_API_URL=http://scale.147.93.5.220.sslip.io/api
DANGEROUSLY_DISABLE_HOST_CHECK=true
CREATE_TEST_DATA=true

# Container names are intentionally NOT fixed in docker-compose.yml
# (avoids conflicts on repeated deploys / multiple stacks).

# Optional PostgreSQL (not used while SQLite is enabled in compose)
# POSTGRES_USER=flaskuser
# POSTGRES_PASSWORD=your-strong-password-here
# POSTGRES_DB=elantar_referral_db

# Optional email
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=noreply@erpelantar.com
